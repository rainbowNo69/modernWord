{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: 直接启动后端并调试",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/server/server.ts",
      "runtimeArgs": ["--import", "tsx"],
      "env": { "PORT": "5000" },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Server: 附加到 9229 (配合 watch 热重载)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
